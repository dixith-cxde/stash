<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- In-app updates: the downloaded release APK is handed to the system installer. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <application>
    <!--
      "Save to Stash" in every app's text-selection menu. A tiny activity with no UI takes the
      selected text and forwards it to MainActivity in Stash's own task, then closes. Apps
      start PROCESS_TEXT for a result, which would otherwise put MainActivity inside the
      caller's task (where the share library relaunches it and the text was lost).
    -->
    <activity
      android:name="expo.modules.expressive.ProcessTextActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:label="Save to Stash"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <!-- Widget "Paste link": reads the clipboard once focused, queues the link, toasts, closes. -->
    <activity
      android:name="expo.modules.expressive.QuickSaveActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- In-app update installs: PackageInstaller session results (UpdateInstaller.kt). -->
    <receiver
      android:name="expo.modules.expressive.UpdateInstallReceiver"
      android:exported="false" />

    <provider
      android:name="expo.modules.expressive.UpdateFileProvider"
      android:authorities="${applicationId}.updates"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/stash_update_paths" />
    </provider>
    <!-- "Save to Stash" home-screen widget (StashWidget.kt): paste link / note / file. -->
    <receiver
      android:name="expo.modules.expressive.StashWidget"
      android:exported="false"
      android:label="@string/stash_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/stash_widget_info" />
    </receiver>
    <!-- 2x2 "Stash quick add" widget (StashWidget.kt). -->
    <receiver
      android:name="expo.modules.expressive.StashWidgetLarge"
      android:exported="false"
      android:label="@string/stash_widget_large_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/stash_widget_large_info" />
    </receiver>
  </application>
</manifest>

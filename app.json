{
  "expo": {
    "name": "Stash",
    "slug": "stash",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stash",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.stash.bookmarks"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EADDFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "app.stash.bookmarks",
      "versionCode": 6
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEF7FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100,
          "dark": {
            "backgroundColor": "#141218",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "application/pdf",
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "application/pdf",
            "*/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          }
        }
      ],
      "./plugins/withProcessText",
      "./plugins/withReleaseSigning",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "GoogleSansFlex",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansFlex-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/GoogleSansFlex-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/GoogleSansFlex-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/GoogleSansFlex-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
